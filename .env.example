# Copy to .env and adjust. .env is gitignored.

# Shows the AI assistant section (hidden by default; it needs the Express API + Ollama, so it doesn't work on Netlify).
# Read by Vite at build time.
# VITE_AI_ASSISTANT=true

# "production" makes the API refuse to start without content/portfolio.json and hides /api/usage.
NODE_ENV=development

PORT=4000
# On the server set 127.0.0.1 so only nginx can reach the app.
# HOST=127.0.0.1

# Set to 1 behind nginx so rate limiting uses the visitor's IP.
TRUST_PROXY=0

# Directory containing portfolio.json (defaults to ./content).
# CONTENT_DIR=content

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Only needed when the frontend is served from a different origin than the API (local Vite dev).
CLIENT_ORIGIN=http://localhost:3000

# Log questions sent to the model in production too.
# LOG_AI_REQUESTS=true
