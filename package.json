{
  "name": "rafal-malyszko-portoflio-v2",
  "author": "Rafal Malyszko",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.0"
  },
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.5.3",
    "three": "^0.186.0",
    "zod": "^3.24.2"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"npm:server:dev\"",
    "dev:client": "vite",
    "server:dev": "tsx server/src/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "node server/dist/server.js",
    "deploy:preview": "npx netlify-cli deploy --build",
    "deploy": "npx netlify-cli deploy --build --prod",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
